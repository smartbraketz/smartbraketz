{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "api/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/scrape", "dest": "/api/scrape.js" },
    { "src": "/api/fetch-image", "dest": "/api/fetch-image.js" },
    { "src": "/flyer-extractor.html", "dest": "/flyer-extractor.html" },
    { "src": "/tournament.html", "dest": "/tournament.html" },
    { "src": "/", "dest": "/flyer-extractor.html" }
  ]
}
